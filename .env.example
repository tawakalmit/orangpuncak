# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ImageKit (upload gambar dari panel admin)
# Dapatkan Public Key, Private Key & URL Endpoint di dashboard ImageKit:
#   https://imagekit.io/dashboard/developer/api-keys
PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx
PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Nomor WhatsApp tujuan (format internasional tanpa + atau 0 di depan, mis. 6281234567890)
PUBLIC_WHATSAPP_NUMBER=6281234567890

# Base URL situs (untuk sitemap & Open Graph)
PUBLIC_SITE_URL=https://orangpuncak.com
