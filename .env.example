# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary (upload gambar dari panel admin)
# Buat "unsigned upload preset" di Settings > Upload pada dashboard Cloudinary.
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Nomor WhatsApp tujuan (format internasional tanpa + atau 0 di depan, mis. 6281234567890)
PUBLIC_WHATSAPP_NUMBER=6281234567890

# Base URL situs (untuk sitemap & Open Graph)
PUBLIC_SITE_URL=https://orangpuncak.com
